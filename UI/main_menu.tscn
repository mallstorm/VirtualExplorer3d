[gd_scene load_steps=5 format=3 uid="uid://virtual_explorer_main_menu"]

[ext_resource type="Script" path="res://UI/main_menu.gd" id="1_menu"]

[sub_resource type="StyleBoxFlat" id="style_panel"]
bg_color = Color(0.035, 0.04, 0.045, 0.94)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[sub_resource type="StyleBoxFlat" id="style_button"]
bg_color = Color(0.09, 0.12, 0.14, 0.92)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[sub_resource type="StyleBoxFlat" id="style_button_pressed"]
bg_color = Color(0.1, 0.42, 1, 0.88)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_menu")

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -360.0
offset_top = -220.0
offset_right = 360.0
offset_bottom = 220.0
theme_override_styles/panel = SubResource("style_panel")

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 24

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "Virtual Explorer"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 34

[node name="Subtitle" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "Плеер внешних ZIP-экскурсий"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 18

[node name="Selected" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "Проекты не установлены"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 20
autowrap_mode = 3

[node name="Continue" type="Button" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_override_styles/normal = SubResource("style_button")
theme_override_styles/pressed = SubResource("style_button_pressed")
text = "Запустить выбранный проект"

[node name="Projects" type="Button" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_override_styles/normal = SubResource("style_button")
theme_override_styles/pressed = SubResource("style_button_pressed")
text = "Следующий проект"

[node name="ImportZip" type="Button" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_override_styles/normal = SubResource("style_button")
theme_override_styles/pressed = SubResource("style_button_pressed")
text = "Импорт ZIP"

[node name="Settings" type="Button" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
